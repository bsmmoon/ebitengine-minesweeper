{
  "name": "Go Dev (Docker)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "containerUser": "dev",
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.autoUpdate": false
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
